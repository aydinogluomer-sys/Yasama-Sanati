# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.chrome-*/
/.edge-*/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.devserver*.log

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Optimizasyon oncesi kaynak dosyalar (~98MB PNG/OTF). Depo gecmisini sismemek icin
# haric tutuldu; gerekirse ayri bir asset deposuna alinmali.
/assets-source/

# impeccable arac durumu: cache, mock gorseller, kritik gunlugu.
/.impeccable/

# Gorsel regresyon: baseline PNG'ler makineye ozgudur (font rasterlestirmesi
# Linux CI ile yerel Windows arasinda farkli). ~6.6MB depo sismesine deger
# gormedik; ilk calistirmada yerelde uretilirler. Bu yuzden kapi YERELDIR,
# CI'da kosmaz. Bkz. qa/visual.mjs basligi.
/qa/visual/

# qa/gates.sh'in depo kokune yazdigi kapi gunlugu. Depoda birikmemeli:
# kokte buyuyen gunluk dosyalari dev sunucusunun izleyicisini bogar.
/qa-gates.log
